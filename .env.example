# Used once, to create the first admin account when the database has none.
# After that, accounts live in the database and are managed at /admin/users —
# changing these has no effect, and they can't be used to log in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-at-least-10-chars

# Signs admin session cookies. Without it, sessions don't survive a restart.
SESSION_SECRET=generate-a-long-random-string-here

# Public origin, used for the absolute links in the calendar feed.
SITE_URL=http://localhost:8080
