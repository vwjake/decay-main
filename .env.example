# Used once, to create the first admin account when the database has none.
# After that, accounts live in the database and are managed at /admin/users —
# changing these has no effect, and they can't be used to log in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-at-least-10-chars

# Signs admin session cookies. Without it, sessions don't survive a restart.
SESSION_SECRET=generate-a-long-random-string-here

# Public origin, used for the absolute links in the calendar feed.
SITE_URL=http://localhost:8080

# SMTP for contact-form notifications. Leave SMTP_HOST unset to disable email
# entirely — messages are still saved to /admin/messages, so nothing is lost;
# they just aren't emailed anywhere. When set, each submission is emailed to
# CONTACT_TO with the sender's address in Reply-To.
#
# DECAY's mail is on Hover: host mail.hover.com, port 587 (STARTTLS) or 465
# (SSL) — both work, the port is auto-detected. SMTP_USER is the full mailbox
# address, SMTP_PASS its password.
# SMTP_HOST=mail.hover.com
# SMTP_PORT=587
# SMTP_USER=noreply@decay.events
# SMTP_PASS=secret
# MAIL_FROM=noreply@decay.events
# CONTACT_TO=info@decayolympia.org

# Read-only .ics share URL of DECAY's internal staff Nextcloud calendar (board
# and organising meetings). Shown, live, on /admin/staff. Leave unset to hide
# that page. This is read only — nothing is ever written back to Nextcloud.
# STAFF_ICS_URL=https://cloud.decay.events/remote.php/dav/public-calendars/TOKEN?export

# Booking mailbox (booking@decayolympia.org) — powers the "Email history" panel
# and reply box on a booking's detail page (/admin/bookings/:id). This is a
# real mailbox read over IMAP, separate from the SMTP_* notification address
# above. Leave BOOKING_IMAP_HOST unset to hide the panel entirely.
#
# This mailbox is on the same cPanel host as decayolympia.org, not Hover:
# host mail.decayolympia.org, port 993 (implicit TLS) for IMAP. SMTP defaults
# to the same host/user/password on port 587 (STARTTLS) — set the BOOKING_SMTP_*
# vars only if that ever needs to differ.
# BOOKING_IMAP_HOST=mail.decayolympia.org
# BOOKING_IMAP_PORT=993
# BOOKING_IMAP_USER=booking@decayolympia.org
# BOOKING_IMAP_PASS=secret
# BOOKING_ADDRESS=booking@decayolympia.org
# BOOKING_FROM_NAME=DECAY Booking
# BOOKING_SMTP_HOST=mail.decayolympia.org
# BOOKING_SMTP_PORT=587
# BOOKING_SMTP_USER=booking@decayolympia.org
# BOOKING_SMTP_PASS=secret

# Stripe integration for shop checkout. Leave STRIPE_SECRET_KEY unset to disable
# Stripe Checkout integration; the shop will fall back to linking out to
# shop.decay.events. When set, the shop uses Stripe's hosted checkout.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
