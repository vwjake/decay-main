# Production environment for the decay-main systemd service.
# Copy to /etc/decay-main.env, fill in real values, then lock it down:
#   sudo cp deploy/decay-main.env.example /etc/decay-main.env
#   sudo chown root:decay /etc/decay-main.env && sudo chmod 640 /etc/decay-main.env
# It holds secrets (SESSION_SECRET, SMTP_PASS), so it must not be world-readable
# and must never be committed.

# Public origin. Being https here is also what flips admin session cookies to
# Secure (HTTPS-only) — see main.go. Must match the real domain.
SITE_URL=https://decay.events

# Signs admin session cookies. Generate once and keep it stable, or every
# restart logs admins out. e.g.  openssl rand -base64 48
SESSION_SECRET=

# Seeds only the FIRST admin account on an empty database; ignored afterwards.
# Change the password in /admin/users right after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SMTP for contact-form notifications (DECAY's mail is on Hover). Leave SMTP_HOST
# unset to disable email — messages still save to /admin/messages either way.
# SMTP_HOST=mail.hover.com
# SMTP_PORT=587
# SMTP_USER=noreply@decay.events
# SMTP_PASS=
# MAIL_FROM=noreply@decay.events
# CONTACT_TO=info@decayolympia.org

# Read-only .ics share URL of DECAY's internal staff Nextcloud calendar.
# Unset leaves /admin/staff hidden.
# STAFF_ICS_URL=https://cloud.decay.events/remote.php/dav/public-calendars/TOKEN?export
