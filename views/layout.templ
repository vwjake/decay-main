package views

templ Layout(title string) {
	@layoutWith(title, "page", Meta{}) {
		{ children... }
	}
}

// WideLayout is the same page in a wider column. The month calendar needs
// seven readable columns, which the site's usual narrow measure can't
// give it.
templ WideLayout(title string) {
	@layoutWith(title, "page page-wide", Meta{}) {
		{ children... }
	}
}

// LayoutWithMeta is Layout plus per-page Open Graph / Twitter preview tags,
// for pages worth sharing (events, posts) where a rich link preview matters.
templ LayoutWithMeta(title string, meta Meta) {
	@layoutWith(title, "page", meta) {
		{ children... }
	}
}

templ layoutWith(title, pageClass string, meta Meta) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			@ogTags(title, meta)
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
			<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/css/style.css"/>
			<script src="https://unpkg.com/htmx.org@1.9.12"></script>
		</head>
		<body>
			<div class={ pageClass }>
				<div class="intro">
					<div class="intro-frame">
						<img src="/static/img/intro.gif" alt=""/>
					</div>
					<div class="intro-label mono">LOADING&hellip;</div>
				</div>
				@Header()
				{ children... }
				@Footer()
			</div>
			<script src="/static/js/app.js"></script>
		</body>
	</html>
}

// ogTags renders the Open Graph and Twitter card meta for a page. Link-preview
// scrapers (Discord, Slack, iMessage, X, Facebook) read these to build the
// preview card; they don't run JavaScript, which is exactly why the tags have
// to be present in the server-rendered HTML rather than added client-side.
templ ogTags(title string, meta Meta) {
	<meta name="description" content={ ogDescription(meta) }/>
	<meta property="og:site_name" content={ siteName }/>
	<meta property="og:title" content={ title }/>
	<meta property="og:description" content={ ogDescription(meta) }/>
	<meta property="og:type" content={ ogType(meta) }/>
	if meta.URL != "" {
		<meta property="og:url" content={ meta.URL }/>
	}
	if meta.Image != "" {
		<meta property="og:image" content={ meta.Image }/>
		<meta name="twitter:card" content="summary_large_image"/>
	} else {
		<meta name="twitter:card" content="summary"/>
	}
}

templ Header() {
	<header class="site-header">
		<a href="/"><img src="/static/img/logo.png" alt="DECAY"/></a>
		<input type="checkbox" id="nav-toggle" class="nav-toggle"/>
		<label for="nav-toggle" class="nav-toggle-btn" aria-label="Menu">&#9776;</label>
		<nav class="site-nav mono">
			<a href="/events">Events</a>
			<a href="/calendar">Calendar</a>
			<a href="/groups">Groups</a>
			<a href="/about">About</a>
			<a href="/blog">Blog</a>
			<a href="/media">Media</a>
			<a href="/shop">Shop</a>
			<a href="/support">Support</a>
			<a href="/get-involved">Get Involved</a>
			<a href="/volunteer">Volunteer</a>
			<a href="/contact">Contact</a>
		</nav>
	</header>
}

templ Footer() {
	<footer class="site-footer">
		<span class="mono">Washington nonprofit &middot; est. 2024</span>
		<span class="mono">402 Washington St NE, Olympia WA</span>
		<span class="footer-copyright mono">&copy; 2026 DECAY Olympia. All rights reserved.</span>
	</footer>
}
