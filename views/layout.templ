package views

templ Layout(title string) {
	@layoutWith(title, "page") {
		{ children... }
	}
}

// WideLayout is the same page in a wider column. The month calendar needs
// seven readable columns, which the site's usual narrow measure can't
// give it.
templ WideLayout(title string) {
	@layoutWith(title, "page page-wide") {
		{ children... }
	}
}

templ layoutWith(title, pageClass string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
			<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/css/style.css"/>
			<script src="https://unpkg.com/htmx.org@1.9.12"></script>
		</head>
		<body>
			<div class={ pageClass }>
				<div class="intro">
					<div class="intro-frame">
						<img src="/static/img/intro.gif" alt=""/>
					</div>
					<div class="intro-label mono">LOADING&hellip;</div>
				</div>
				@Header()
				{ children... }
				@Footer()
			</div>
			<script src="/static/js/app.js"></script>
		</body>
	</html>
}

templ Header() {
	<header class="site-header">
		<a href="/"><img src="/static/img/logo.png" alt="DECAY"/></a>
		<nav class="site-nav mono">
			<a href="/events">Events</a>
			<a href="/calendar">Calendar</a>
			<a href="/groups">Groups</a>
			<a href="/about">About</a>
			<a href="/blog">Blog</a>
			<a href="/photos">Photos</a>
			<a href="/shop">Shop</a>
			<a href="/support">Support</a>
		</nav>
	</header>
}

templ Footer() {
	<footer class="site-footer">
		<img src="/static/img/logo.png" alt="DECAY"/>
		<span class="mono">Washington nonprofit &middot; est. 2024</span>
		<span class="mono">402 Washington St NE, Olympia WA</span>
		<nav class="footer-links mono">
			<a href="/about">About</a>
			<a href="/support">Support</a>
			<a href="/policies">Safer space</a>
			<a href="/events.ics">Calendar feed</a>
		</nav>
		<span class="mono copyright">&copy; 2026 DECAY Olympia. All rights reserved.</span>
	</footer>
}
