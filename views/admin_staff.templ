package views

import (
	"strconv"
	"time"

	"decay-main/db"
)

// CalCategory tags one entry on the admin calendar grid, so the on/off
// checkboxes above it can show or hide a whole category with pure CSS.
type CalCategory string

const (
	CalEvent   CalCategory = "event"
	CalRequest CalCategory = "request"
	CalStaff   CalCategory = "staff"
)

// CalEntry is one item on the admin calendar — an event, a booking request
// with a parseable preferred date, or a staff meeting — reduced to what the
// grid needs to render.
type CalEntry struct {
	Category CalCategory
	Time     string
	Title    string
	Href     string
	// Linkable is false when Href shouldn't be offered — a booking request
	// when the viewer can't open Bookings, or a meeting, which lives on
	// Nextcloud rather than anywhere on this site.
	Linkable bool
}

func (e CalEntry) CategoryClass() string { return "cal-cat-" + string(e.Category) }

// AdminCalDay is one cell of the admin calendar's month grid.
type AdminCalDay struct {
	Date    time.Time
	InMonth bool
	Today   bool
	Entries []CalEntry
}

func (d AdminCalDay) Number() string { return strconv.Itoa(d.Date.Day()) }

// AdminCalMonth lays events, requests, and meetings out on one shared month
// grid, the way the admin calendar page reads them together.
type AdminCalMonth struct {
	Month time.Time
	Weeks [][]AdminCalDay
	// Prev and Next are "2006-01" values for the navigation links.
	Prev string
	Next string
	// Count is how many entries (of any category) fall in the month.
	Count int
}

func (m AdminCalMonth) Label() string { return m.Month.Format("January 2006") }

// StaffPage is everything the admin calendar screen renders.
type StaffPage struct {
	Configured bool
	Error      string
	Calendar   AdminCalMonth
	Venue      *time.Location
}

templ AdminStaff(p StaffPage, me db.User) {
	@AdminLayout("Calendar · DECAY Admin", me) {
		<p class="admin-heading">Calendar</p>
		<p class="admin-sub mono">Events, booking requests, and staff meetings in one place. Toggle a category to focus on it.</p>

		if !p.Configured {
			<div class="admin-flash mono">
				No staff calendar is connected yet. Set <code>STAFF_ICS_URL</code> to the
				share link of DECAY's internal Nextcloud calendar (its read-only <code>.ics</code>
				export URL) and restart, and its meetings will show up here too.
			</div>
		} else if p.Error != "" {
			<div class="admin-flash admin-flash-error mono">{ p.Error }</div>
		}

		<nav class="pager mono">
			<a href={ templ.URL("/admin/staff?month=" + p.Calendar.Prev) } class="pager-link">&larr; Prev</a>
			<span class="pager-status">{ p.Calendar.Label() }</span>
			<a href={ templ.URL("/admin/staff?month=" + p.Calendar.Next) } class="pager-link">Next &rarr;</a>
		</nav>

		<input type="checkbox" id="cal-filter-event" class="cal-filter-toggle" checked/>
		<label for="cal-filter-event" class="cal-filter-btn">Events</label>
		<input type="checkbox" id="cal-filter-request" class="cal-filter-toggle" checked/>
		<label for="cal-filter-request" class="cal-filter-btn">Requests</label>
		<input type="checkbox" id="cal-filter-staff" class="cal-filter-toggle" checked/>
		<label for="cal-filter-staff" class="cal-filter-btn">Staff meetings</label>

		<div class="calendar-scroll">
			<table class="calendar">
				<thead>
					<tr>
						for _, day := range db.Weekdays {
							<th class="mono">{ day }</th>
						}
					</tr>
				</thead>
				<tbody>
					for _, week := range p.Calendar.Weeks {
						<tr>
							for _, day := range week {
								if day.InMonth {
									<td class={ "cal-day", templ.KV("is-today", day.Today) }>
										<span class="cal-date mono">{ day.Number() }</span>
										for _, entry := range day.Entries {
											@calEntry(entry)
										}
									</td>
								} else {
									<td class="cal-day is-outside"></td>
								}
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
		if p.Calendar.Count == 0 {
			<p class="subscribe-note mono">Nothing on the calendar this month.</p>
		}
	}
}

templ calEntry(e CalEntry) {
	if e.Linkable {
		<a href={ templ.URL(e.Href) } class={ "cal-event", e.CategoryClass(), templ.KV("cal-meeting", e.Category == CalStaff), templ.KV("cal-request", e.Category == CalRequest) } title={ e.Title }>
			@calEntryBody(e)
		</a>
	} else {
		<span class={ "cal-event", e.CategoryClass(), templ.KV("cal-meeting", e.Category == CalStaff), templ.KV("cal-request", e.Category == CalRequest) } title={ e.Title }>
			@calEntryBody(e)
		</span>
	}
}

templ calEntryBody(e CalEntry) {
	if e.Time != "" {
		<span class="cal-event-time mono">{ e.Time }</span>
	}
	<span class="cal-event-title">{ db.ShortTitle(e.Title) }</span>
}
