package views

import "decay-main/db"

templ Photos(photos []db.Photo) {
	@Layout("Photos · DECAY") {
		<section class="about">
			<p class="about-statement">Photos</p>
			<p class="about-body">Shows, workshops, and whatever else happened at 402 Washington St NE.</p>
		</section>
		<section class="events">
			if len(photos) == 0 {
				<p class="about-body">No photos yet — check back soon.</p>
			} else {
				<div class="gallery">
					for _, p := range photos {
						<figure class="gallery-item">
							<a href={ templ.URL(p.Path()) } target="_blank" rel="noopener">
								<img src={ p.WebPath() } alt={ p.Alt() } loading="lazy"/>
							</a>
							if p.Caption != "" {
								<figcaption class="gallery-caption mono">{ p.Caption }</figcaption>
							}
						</figure>
					}
				</div>
			}
		</section>
	}
}
