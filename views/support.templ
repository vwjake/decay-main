package views

// Support merges the old site's support and donate pages: how to give,
// and who already does.
templ Support() {
	@Layout("Support · DECAY") {
		<section class="about">
			<p class="about-statement">Support DECAY</p>
			<p class="about-body">
				DECAY runs on community support. We're a Washington State Nonprofit
				Corporation in the process of establishing our own 501(c)(3), and we
				appreciate any and all fiscal support &mdash; as well as donations in kind.
			</p>
		</section>

		<section class="events">
			<span class="section-label mono">Give</span>
			<p class="about-body">
				Donations over $250, or any donation you'd like a tax receipt for, should go
				through our fiscal sponsor on Givebutter. A Patreon pledge is the way to
				support us regularly.
			</p>
			<a href="https://givebutter.com/SupportDECAY" class="btn-outline mono" target="_blank" rel="noopener">Donate once</a>
			<a href="https://www.patreon.com/decayolympia" class="btn-outline mono" target="_blank" rel="noopener">Pledge monthly</a>
			<p class="about-body">
				We also accept cash and cheque at the space, or by post:
			</p>
			<address class="mono postal">
				DECAY<br/>
				402 Washington St NE<br/>
				Olympia, WA 98501
			</address>
		</section>

		<section class="about">
			<span class="section-label mono">Give time</span>
			<p class="about-body">
				Volunteers keep the doors open &mdash; working the door and concessions,
				running sound, taking photos, tidying up, promoting events, putting flyers up
				around town. Show up fifteen minutes before an event and say you'd like to
				help, or ask on Discord, where we call for hands when an event is short.
			</p>
			<p class="about-body">
				Work half an event and you get in free, and there's seltzer on the house.
			</p>
			<a href="https://discord.gg/YUAuEvwa9X" class="btn-outline mono" target="_blank" rel="noopener">Join the Discord</a>
		</section>

		<section class="events">
			<span class="section-label mono">Put on an event</span>
			<p class="about-body">
				Want to host a show, workshop, screening, or gathering at DECAY? Send us a
				booking request and we'll be in touch to talk dates.
			</p>
			<a href="/book" class="btn-outline mono">Request a booking</a>
		</section>

		<section class="about">
			<span class="section-label mono">Thanks to</span>
			<p class="about-body">
				We're partially funded by the Olympia Inspire Grant, represented by Shunpike,
				and kept breathable by Clean Air Oly, who supply the space's high-capacity air
				purification. We're also partnering with Free Music Olympia on a free all-ages
				music event every month.
			</p>
			<div class="partner-grid">
				<a href="https://olympiawa.gov/inspire" target="_blank" rel="noopener">
					<img src="/static/img/partners/Inspire-Olympia_Patch-Black.png" alt="Inspire Olympia"/>
				</a>
				<a href="https://shunpike.org/" target="_blank" rel="noopener">
					<img src="/static/img/partners/Shunpike_primary-logo.png" alt="Shunpike"/>
				</a>
				<a href="https://cleanairoly.org/" target="_blank" rel="noopener">
					<img src="/static/img/partners/cleanairlogoblk.png" alt="Clean Air Olympia"/>
				</a>
				<a href="https://www.freemusicolympia.org/" target="_blank" rel="noopener">
					<img src="/static/img/partners/free_music_olympia_logo__with_background.png" alt="Free Music Olympia"/>
				</a>
			</div>
		</section>
	}
}
