package views

import "decay-main/db"

// Groups is the public index of DECAY's categories.
templ Groups(groups []db.Group) {
	@Layout("Groups · DECAY") {
		<section class="about">
			<p class="about-statement">Groups at DECAY</p>
			<p class="about-body">
				Browse what happens at DECAY by category. Explore each one to
				learn what to bring, how to plug in, and what to expect when you show up.
			</p>
		</section>

		<section class="events">
			<div class="group-list">
				for _, g := range groups {
					<a class="group-card" href={ templ.URL(g.Path()) }>
						<span class="group-card-name">{ g.Name }</span>
						<span class="group-card-summary">{ g.Summary }</span>
						<span class="group-card-more mono">Learn more &rarr;</span>
					</a>
				}
			</div>
		</section>
	}
}

// GroupPage is one program's detail page. upcoming is the group's own slice
// of the calendar, soonest first; photos are the shots tagged to it.
templ GroupPage(g db.Group, upcoming []db.Event, photos []db.Photo) {
	@Layout(g.Name + " · DECAY") {
		<section class="event-detail group-detail">
			<a href="/groups" class="event-back mono">&larr; All groups</a>
			if g.HasHero() {
				<img class="group-hero" src={ g.HeroPath() } alt={ g.HeroAlt }/>
			}
			<span class="section-label mono">Group at DECAY</span>
			<h1 class="event-detail-title">{ g.Name }</h1>
			if len(g.PillList()) > 0 {
				<div class="group-pills mono">
					for _, pill := range g.PillList() {
						<span class="group-pill">{ pill }</span>
					}
				</div>
			}
			if g.Description != "" {
				<p class="event-detail-body">{ g.Description }</p>
			}
			<div class="group-schedule">
				<h2 class="group-section-title mono">Upcoming</h2>
				if len(upcoming) > 0 {
					<div class="event-list">
						for _, ev := range upcoming {
							@eventRow(ev)
						}
					</div>
					<a href="/calendar" class="btn-outline mono">Full calendar</a>
				} else {
					<p class="admin-sub mono">Nothing on the calendar right now — check back soon.</p>
				}
			</div>
			for _, block := range g.Sections() {
				<div class="group-section">
					if block.Heading != "" {
						<h2 class="group-section-title mono">{ block.Heading }</h2>
					}
					for _, para := range block.Paragraphs {
						<p class="event-detail-body">
							@segments(para)
						</p>
					}
					if len(block.Bullets) > 0 {
						<ul class="group-bullets">
							for _, item := range block.Bullets {
								<li>
									@segments(item)
								</li>
							}
						</ul>
					}
				</div>
			}
			if len(photos) > 0 {
				<div class="group-photos">
					<h2 class="group-section-title mono">Photos</h2>
					<div class="gallery">
						for _, photo := range photos {
							<figure class="gallery-item">
								<a href={ templ.URL(photo.WebPath()) } target="_blank" rel="noopener">
									<img src={ photo.WebPath() } alt={ photo.Alt() } loading="lazy"/>
								</a>
								if photo.Caption != "" {
									<figcaption class="gallery-caption mono">{ photo.Caption }</figcaption>
								}
							</figure>
						}
					</div>
				</div>
			}
		</section>
	}
}

// segments renders a parsed line, turning link runs into anchors and
// leaving plain runs as escaped text.
templ segments(segs []db.Segment) {
	for _, seg := range segs {
		if seg.IsLink() {
			<a href={ templ.URL(seg.URL) } target="_blank" rel="noopener">{ seg.Text }</a>
		} else {
			{ seg.Text }
		}
	}
}
