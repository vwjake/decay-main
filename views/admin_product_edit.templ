package views

import (
	"fmt"

	"decay-main/db"
)

templ AdminProductEdit(p db.Product, me db.User, errorMsg string) {
	@AdminLayout(p.Name+" · DECAY Admin", me) {
		<a href="/admin/products" class="admin-back">&larr; All items</a>
		<p class="admin-heading">{ p.Name }</p>
		if errorMsg != "" {
			<div class="admin-flash admin-flash-error mono">{ errorMsg }</div>
		}
		<form method="post" action={ templ.URL(fmt.Sprintf("/admin/products/%d", p.ID)) } class="admin-form">
			<label>Name<input type="text" name="name" value={ p.Name } required/></label>
			<label>
				Price (dollars)
				<input type="number" name="price" step="0.01" min="0" value={ fmt.Sprintf("%.2f", float64(p.PriceCents)/100) } required/>
			</label>
			<label>Description<textarea name="description">{ p.Description }</textarea></label>
			<label>Variants (shown as text)<input type="text" name="variants" value={ p.Variants }/></label>
			<label>Placeholder text (shown when there's no photo)<input type="text" name="placeholder" value={ p.Placeholder }/></label>
			<label>Buy link<input type="text" name="stripe_url" value={ p.StripeURL } placeholder="https://shop.decay.events/..."/></label>
			<label>Stripe Price ID (for Checkout)<input type="text" name="stripe_price_id" value={ p.StripePriceID } placeholder="price_..."/></label>
			<label>Order<input type="number" name="position" value={ fmt.Sprint(p.Position) }/></label>
			<label class="inline">
				<input type="checkbox" name="sold_out" value="1" checked?={ p.SoldOut }/> Sold out
			</label>
			<button type="submit" class="admin-btn">Save item</button>
		</form>

		<p class="admin-heading">Photo</p>
		if p.HasImage() {
			<img class="admin-flyer-preview" src={ p.ImagePath() } alt={ p.Name }/>
		} else {
			<p class="admin-sub mono">No photo yet — the listing shows the placeholder text.</p>
		}
		<form method="post" action={ templ.URL(fmt.Sprintf("/admin/products/%d/image", p.ID)) } enctype="multipart/form-data" class="admin-form">
			<label>
				if p.HasImage() {
					Replace photo
				} else {
					Upload photo
				}
				<input type="file" name="image" accept="image/*" required/>
			</label>
			<button type="submit" class="admin-btn">Save photo</button>
		</form>
	}
}
