package views

import (
	"fmt"

	"decay-main/db"
)

templ AdminProducts(products []db.Product, me db.User, errorMsg, notice string, stripeReady bool) {
	@AdminLayout("Shop · DECAY Admin", me) {
		<p class="admin-heading">Shop</p>
		if errorMsg != "" {
			<div class="admin-flash admin-flash-error mono">{ errorMsg }</div>
		}
		if notice != "" {
			<div class="admin-flash mono">{ notice }</div>
		}
		<p class="admin-sub mono">Shown on the public /shop page in the order below.</p>
		<form method="post" action="/admin/products/sync" class="admin-form">
			<p class="admin-sub mono">
				Items are added and priced in Stripe, then pulled in here. Names,
				prices, and descriptions come from Stripe; photos are kept on this
				site, so syncing never replaces one.
			</p>
			if !stripeReady {
				<p class="admin-sub mono">Stripe isn't configured yet — set STRIPE_SECRET_KEY to enable this.</p>
			}
			<button type="submit" class="admin-btn" disabled?={ !stripeReady }>Sync from Stripe</button>
		</form>
		<table class="admin-table">
			<tr>
				<th>Order</th>
				<th>Name</th>
				<th>Price</th>
				<th>Status</th>
				<th></th>
			</tr>
			for _, p := range products {
				<tr>
					<td class="mono">{ fmt.Sprint(p.Position) }</td>
					<td>
						<a href={ templ.URL(fmt.Sprintf("/admin/products/%d", p.ID)) }>{ p.Name }</a>
					</td>
					<td>{ p.Price() }</td>
					<td class="mono">
						if p.SoldOut {
							sold out
						} else {
							available
						}
						if p.SyncedFromStripe() {
							· stripe
						}
					</td>
					<td class="admin-row-actions">
						<a class="admin-btn" href={ templ.URL(fmt.Sprintf("/admin/products/%d", p.ID)) }>Edit</a>
					</td>
				</tr>
			}
		</table>
		if len(products) == 0 {
			<p class="admin-sub mono">Nothing here yet — add an item in Stripe, then sync.</p>
		}
	}
}
