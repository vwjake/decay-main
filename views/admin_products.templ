package views

import (
	"fmt"

	"decay-main/db"
)

templ AdminProducts(products []db.Product, me db.User, errorMsg string) {
	@AdminLayout("Shop · DECAY Admin", me) {
		<p class="admin-heading">Shop</p>
		if errorMsg != "" {
			<div class="admin-flash admin-flash-error mono">{ errorMsg }</div>
		}
		<p class="admin-sub mono">Shown on the public /shop page in the order below.</p>
		<table class="admin-table">
			<tr>
				<th>Order</th>
				<th>Name</th>
				<th>Price</th>
				<th>Status</th>
				<th></th>
			</tr>
			for _, p := range products {
				<tr>
					<td class="mono">{ fmt.Sprint(p.Position) }</td>
					<td>
						<a href={ templ.URL(fmt.Sprintf("/admin/products/%d", p.ID)) }>{ p.Name }</a>
					</td>
					<td>{ p.Price() }</td>
					<td class="mono">
						if p.SoldOut {
							sold out
						} else {
							available
						}
					</td>
					<td>
						<form method="post" action={ templ.URL(fmt.Sprintf("/admin/products/%d/delete", p.ID)) } onsubmit="return confirm('Delete this product?')">
							<button type="submit" class="admin-btn admin-btn-danger">Delete</button>
						</form>
					</td>
				</tr>
			}
		</table>

		<p class="admin-heading">Add product</p>
		<form method="post" action="/admin/products" class="admin-form">
			<label>Name<input type="text" name="name" required/></label>
			<label>Price (USD)<input type="number" name="price" min="0" step="0.01" required/></label>
			<label>Description (optional)<textarea name="description"></textarea></label>
			<label>Placeholder text<input type="text" name="placeholder" placeholder="product photo"/></label>
			<label>Stripe link (optional)<input type="text" name="stripe_url"/></label>
			<label>Stripe Price ID (optional)<input type="text" name="stripe_price_id" placeholder="price_..."/></label>
			<label>Order<input type="number" name="position" value="0"/></label>
			<p class="admin-sub mono">Add the photo, variants, and sold-out status after creating it.</p>
			<button type="submit" class="admin-btn">Create</button>
		</form>
	}
}
