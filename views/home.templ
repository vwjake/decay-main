package views

import (
	"decay-main/db"
	"decay-main/youtube"
)

// videoTitle gives the embed's iframe a non-empty accessible name even when
// no caption was set.
func videoTitle(v db.Video) string {
	if v.Title != "" {
		return v.Title
	}
	return "DECAY video"
}

templ Home(events []db.Event, products []db.Product, videos []db.Video, latestYouTube *youtube.Video, stripeReady bool) {
	@Layout("DECAY") {
		<section id="top" class="hero">
			<div class="hero-box">
				<img src="/static/img/logo.png" alt="DECAY"/>
			</div>
			<p class="hero-tagline mono">Community Arts &amp; Tech Space &middot; Olympia, WA</p>
		</section>

		<section id="about" class="about">
			<p class="about-statement">A community arts and technology space in the heart of Olympia, Washington.</p>
			<p class="about-body">Founded in October 2024, DECAY provides an accessible venue for performances, workshops, exhibitions, and experimental programming that connects creative practice with STEM learning. We're a Washington State&ndash;certified nonprofit transitioning to independent 501(c)(3) status.</p>
		</section>

		<section id="events" class="events">
			<span class="section-label mono">Upcoming events</span>
			<div class="event-list">
				for _, ev := range events {
					@eventRow(ev)
				}
			</div>
			<a href="/events" class="btn-outline mono">Full calendar</a>
		</section>

		<section id="merch" class="merch">
			<span class="section-label mono">Shop</span>
			<p class="merch-intro">Merch keeps the space running.</p>
			<div class="merch-grid">
				for _, item := range products {
					@merchCard(item, stripeReady)
				}
			</div>
			<a href="/shop" class="btn-outline mono">Browse the shop</a>
		</section>

		<section id="media" class="media">
			<span class="section-label mono">Media</span>
			<p class="merch-intro">Sets and sessions recorded at the space.</p>
			if latestYouTube != nil {
				<div class="media-list">
					<div class="media-video">
						<div class="media-video-frame">
							<iframe
								src={ templ.URL(latestYouTube.EmbedURL()) }
								title={ latestYouTube.Title }
								loading="lazy"
								referrerpolicy="strict-origin-when-cross-origin"
								allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
								allowfullscreen
							></iframe>
						</div>
						if latestYouTube.Title != "" {
							<div class="media-video-caption mono">
								<span>{ latestYouTube.Title }</span>
								<a href={ templ.URL(latestYouTube.WatchURL()) } target="_blank" rel="noopener">YouTube &rarr;</a>
							</div>
						}
					</div>
				</div>
			} else if len(videos) > 0 {
				<div class="media-list">
					for _, v := range videos {
						<div class="media-video">
							<div class="media-video-frame">
								<iframe
									src={ templ.URL(v.EmbedURL()) }
									title={ videoTitle(v) }
									loading="lazy"
									referrerpolicy="strict-origin-when-cross-origin"
									allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
									allowfullscreen
								></iframe>
							</div>
							if v.Title != "" {
								<div class="media-video-caption mono">
									<span>{ v.Title }</span>
									<a href={ templ.URL(v.WatchURL()) } target="_blank" rel="noopener">YouTube &rarr;</a>
								</div>
							}
						</div>
					}
				</div>
			}
			<a href="/media" class="btn-outline mono">Browse more</a>
		</section>

		<section id="contact" class="contact">
			<span class="section-label mono">Join the list</span>
			<p class="contact-heading">Get event announcements in your inbox.</p>
			<a href="https://decay.beehiiv.com" class="btn-outline mono" target="_blank" rel="noopener">
				Subscribe to the newsletter
			</a>
			<div class="social-links mono">
				<a href="https://instagram.com/decay_olympia" target="_blank" rel="noopener">Instagram</a>
				<a href="https://discord.gg/YUAuEvwa9X" target="_blank" rel="noopener">Discord</a>
			</div>
		</section>
	}
}
