package views

import (
	"fmt"
	"time"

	"decay-main/bookingmail"
	"decay-main/db"
)

// BookingDetailData bundles a booking with its correspondence for the
// detail page. Thread is the zero value when the mailbox isn't configured
// or the booking has no email on file, in which case the panel explains why
// instead of showing a broken one.
type BookingDetailData struct {
	Booking        db.BookingRequest
	Thread         bookingmail.Thread
	CanSend        bool
	MailboxAddress string
	Venue          *time.Location
	FlashError     string
	FlashNotice    string
}

func (d BookingDetailData) emailThread() EmailThreadData {
	return EmailThreadData{
		Kind:           "bookings",
		ID:             d.Booking.ID,
		Email:          d.Booking.Email,
		Thread:         d.Thread,
		CanSend:        d.CanSend,
		MailboxAddress: d.MailboxAddress,
		Venue:          d.Venue,
	}
}

templ AdminBookingDetail(d BookingDetailData, me db.User) {
	@AdminLayout(fmt.Sprintf("%s · DECAY Admin", d.Booking.Name), me) {
		<div class="admin-heading-row">
			<a href="/admin/bookings" class="admin-btn admin-btn-small">← All requests</a>
		</div>
		if d.FlashNotice != "" {
			<div class="admin-flash mono">{ d.FlashNotice }</div>
		}
		if d.FlashError != "" {
			<div class="admin-flash admin-flash-error mono">{ d.FlashError }</div>
		}
		<div class="booking-card">
			<div class="booking-head">
				<strong>{ d.Booking.Name }</strong>
				<span class="mono booking-when">{ d.Booking.When() }</span>
			</div>
			<dl class="booking-fields mono">
				if d.Booking.EventName != "" {
					<dt>Event</dt>
					<dd>{ d.Booking.EventName }</dd>
				}
				@bookingContact(d.Booking)
				if d.Booking.PreferredDate != "" {
					<dt>Dates</dt>
					<dd>{ d.Booking.PreferredDate }</dd>
				}
				if d.Booking.ExpectedAttendance != "" {
					<dt>Headcount</dt>
					<dd>{ d.Booking.ExpectedAttendance }</dd>
				}
			</dl>
			if d.Booking.Description != "" {
				<p class="booking-desc">{ d.Booking.Description }</p>
			}
			<div class="booking-actions">
				<a href={ templ.URL(fmt.Sprintf("/admin/events?from_booking=%d#add-event", d.Booking.ID)) } class="admin-btn admin-btn-small">Convert to event</a>
				<form method="post" action={ templ.URL(fmt.Sprintf("/admin/bookings/%d/delete", d.Booking.ID)) } onsubmit="return confirm('Delete this request for good?')">
					<button type="submit" class="admin-btn admin-btn-small admin-btn-danger">Delete</button>
				</form>
			</div>
		</div>

		<div class="admin-heading-row" style="margin-top:1.6em;">
			<p class="admin-heading">Notes</p>
		</div>
		<form method="post" action={ templ.URL(fmt.Sprintf("/admin/bookings/%d/notes", d.Booking.ID)) } class="admin-form">
			<label>
				Private — never shown to the requester
				<textarea name="notes" rows="4" placeholder="What's been discussed, decided, or still needs to happen.">{ d.Booking.Notes }</textarea>
			</label>
			<button type="submit" class="admin-btn admin-btn-small">Save notes</button>
		</form>

		@emailThreadPanel(d.emailThread())
	}
}
