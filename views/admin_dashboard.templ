package views

import (
	"fmt"

	"decay-main/db"
)

// AdminDashboard opens the panel with what needs attention rather than a
// bare list of links: what's on next, and what's missing from it.
templ AdminDashboard(c db.Counts, me db.User) {
	@AdminLayout("Dashboard · DECAY Admin", me) {
		<p class="admin-heading">Dashboard</p>

		if c.NextEvent != nil {
			<div class="admin-next">
				<span class="section-label mono">Next up</span>
				<a class="admin-next-title" href={ templ.URL(fmt.Sprintf("/admin/events/%d", c.NextEvent.ID)) }>
					{ c.NextEvent.Title }
				</a>
				<span class="mono admin-next-when">
					{ c.NextEvent.LongDate() } &middot; { c.NextEvent.TimeRange() }
				</span>
			</div>
		} else {
			<p class="admin-sub mono">Nothing on the calendar yet.</p>
		}

		if c.NewBookings > 0 || c.NewMessages > 0 || c.NewSignups > 0 || c.OpenRoles > 0 || c.Drafts > 0 {
			<p class="admin-heading">Needs attention</p>
			<div class="event-list">
				if c.NewBookings > 0 && me.Can(db.PermBookings) {
					<a href="/admin/bookings" class="event-item">
						<div class="event-title">{ plural(c.NewBookings, "new booking request", "new booking requests") }</div>
						<div class="event-date mono">{ fmt.Sprint(c.NewBookings) }</div>
					</a>
				}
				if c.NewMessages > 0 && me.Can(db.PermMessages) {
					<a href="/admin/messages" class="event-item">
						<div class="event-title">{ plural(c.NewMessages, "new message", "new messages") }</div>
						<div class="event-date mono">{ fmt.Sprint(c.NewMessages) }</div>
					</a>
				}
				if c.NewSignups > 0 && me.Can(db.PermEvents) {
					<a href="/admin/events" class="event-item">
						<div class="event-title">{ plural(c.NewSignups, "volunteer signup", "volunteer signups") } to follow up</div>
						<div class="event-date mono">{ fmt.Sprint(c.NewSignups) }</div>
					</a>
				}
				if c.OpenRoles > 0 {
					<a href="/admin/events" class="event-item">
						<div class="event-title">{ plural(c.OpenRoles, "volunteer slot", "volunteer slots") } unfilled</div>
						<div class="event-date mono">{ fmt.Sprint(c.OpenRoles) }</div>
					</a>
				}
				if c.Drafts > 0 {
					<a href="/admin/posts" class="event-item">
						<div class="event-title">{ plural(c.Drafts, "unpublished draft", "unpublished drafts") }</div>
						<div class="event-date mono">{ fmt.Sprint(c.Drafts) }</div>
					</a>
				}
			</div>
		}

		<p class="admin-heading">Manage</p>
		<div class="dashboard-grid">
			@dashboardCard("/admin/events", "Events",
				fmt.Sprintf("%d upcoming · %d past", c.UpcomingEvents, c.PastEvents),
				"Create and manage upcoming events, volunteer roles, and event signups.")
			@dashboardCard("/admin/posts", "Blog",
				fmt.Sprintf("%d published · %d draft", c.PublishedPosts, c.Drafts),
				"Write and publish blog posts with Markdown formatting.")
			@dashboardCard("/admin/products", "Shop", fmt.Sprintf("%d items", c.Products),
				"Manage products and sync inventory from Stripe.")
			@dashboardCard("/admin/photos", "Photos", fmt.Sprintf("%d photos", c.Photos),
				"Upload and organize photo galleries and event photos.")
			if me.Can(db.PermPeople) {
				@dashboardCard("/admin/people", "People", "board & staff profiles",
					"Manage board members and staff profiles with photos and bios.")
				@dashboardCard("/admin/bios", "Bios", "community member profiles",
					"Community member profiles and biographical information.")
			}
			if me.Can(db.PermGroups) {
				@dashboardCard("/admin/groups", "Groups", "recurring programs",
					"Create recurring programs and group activities.")
			}
			if me.Can(db.PermMedia) {
				@dashboardCard("/admin/media", "Media", "embedded videos",
					"Embed and manage YouTube videos and media content.")
			}
			if me.Can(db.PermBookings) {
				@dashboardCard("/admin/bookings", "Bookings", "requests to use the space",
					"Review and manage space booking requests.")
			}
			if me.Can(db.PermMessages) {
				@dashboardCard("/admin/messages", "Messages", "contact form inbox",
					"Read and respond to messages from the contact form.")
			}
			if me.Can(db.PermForms) {
				@dashboardCard("/admin/forms", "Forms", "Get Involved page links",
					"Manage links and content on the Get Involved page.")
			}
			if me.Can(db.PermReports) {
				@dashboardCard("/admin/reports", "Reports", "quarterly and custom stats",
					"Generate quarterly reports and custom statistics.")
			}
			if me.Can(db.PermUsers) {
				@dashboardCard("/admin/users", "Accounts", "who can sign in here",
					"Manage user accounts and access permissions.")
			}
		</div>
	}
}

templ dashboardCard(href, title, meta, desc string) {
	<a href={ templ.URL(href) } class="dashboard-card">
		<div class="dashboard-card-header">
			<div class="dashboard-card-title">{ title }</div>
			<div class="dashboard-card-meta mono">{ meta }</div>
		</div>
		<p class="dashboard-card-desc">{ desc }</p>
	</a>
}

// plural picks the singular or plural noun and prefixes the count.
func plural(n int, one, many string) string {
	if n == 1 {
		return fmt.Sprintf("%d %s", n, one)
	}
	return fmt.Sprintf("%d %s", n, many)
}
