package views

import (
	"fmt"

	"decay-main/db"
)

// AdminDashboard opens the panel with what needs attention rather than a
// bare list of links: what's on next, and what's missing from it.
templ AdminDashboard(c db.Counts, me db.User) {
	@AdminLayout("Dashboard · DECAY Admin", me) {
		<p class="admin-heading">Dashboard</p>

		if c.NextEvent != nil {
			<div class="admin-next">
				<span class="section-label mono">Next up</span>
				<a class="admin-next-title" href={ templ.URL(fmt.Sprintf("/admin/events/%d", c.NextEvent.ID)) }>
					{ c.NextEvent.Title }
				</a>
				<span class="mono admin-next-when">
					{ c.NextEvent.LongDate() } &middot; { c.NextEvent.TimeRange() }
				</span>
			</div>
		} else {
			<p class="admin-sub mono">Nothing on the calendar yet.</p>
		}

		if c.NewBookings > 0 || c.NewSignups > 0 || c.OpenRoles > 0 || c.Drafts > 0 {
			<p class="admin-heading">Needs attention</p>
			<div class="event-list">
				if c.NewBookings > 0 && me.Can(db.PermBookings) {
					<a href="/admin/bookings" class="event-item">
						<div class="event-title">{ plural(c.NewBookings, "new booking request", "new booking requests") }</div>
						<div class="event-date mono">{ fmt.Sprint(c.NewBookings) }</div>
					</a>
				}
				if c.NewSignups > 0 && me.Can(db.PermEvents) {
					<a href="/admin/events" class="event-item">
						<div class="event-title">{ plural(c.NewSignups, "volunteer signup", "volunteer signups") } to follow up</div>
						<div class="event-date mono">{ fmt.Sprint(c.NewSignups) }</div>
					</a>
				}
				if c.OpenRoles > 0 {
					<a href="/admin/events" class="event-item">
						<div class="event-title">{ plural(c.OpenRoles, "volunteer slot", "volunteer slots") } unfilled</div>
						<div class="event-date mono">{ fmt.Sprint(c.OpenRoles) }</div>
					</a>
				}
				if c.Drafts > 0 {
					<a href="/admin/posts" class="event-item">
						<div class="event-title">{ plural(c.Drafts, "unpublished draft", "unpublished drafts") }</div>
						<div class="event-date mono">{ fmt.Sprint(c.Drafts) }</div>
					</a>
				}
			</div>
		}

		<p class="admin-heading">Manage</p>
		<div class="event-list">
			@adminLink("/admin/events", "Events",
				fmt.Sprintf("%d upcoming · %d past", c.UpcomingEvents, c.PastEvents))
			@adminLink("/admin/posts", "Blog",
				fmt.Sprintf("%d published · %d draft", c.PublishedPosts, c.Drafts))
			@adminLink("/admin/products", "Shop", fmt.Sprintf("%d items", c.Products))
			@adminLink("/admin/photos", "Photos", fmt.Sprintf("%d photos", c.Photos))
			if me.Can(db.PermPeople) {
				@adminLink("/admin/people", "People", "board & staff profiles")
			}
			if me.Can(db.PermGroups) {
				@adminLink("/admin/groups", "Groups", "recurring programs")
			}
			if me.Can(db.PermBookings) {
				@adminLink("/admin/bookings", "Bookings", "requests to use the space")
			}
			if me.Can(db.PermReports) {
				@adminLink("/admin/reports", "Reports", "quarterly and custom stats")
			}
			if me.Can(db.PermUsers) {
				@adminLink("/admin/users", "Accounts", "who can sign in here")
			}
		</div>
	}
}

templ adminLink(href, title, meta string) {
	<a href={ templ.URL(href) } class="event-item">
		<div>
			<div class="event-title">{ title }</div>
			<div class="event-meta mono">{ meta }</div>
		</div>
	</a>
}

// plural picks the singular or plural noun and prefixes the count.
func plural(n int, one, many string) string {
	if n == 1 {
		return fmt.Sprintf("%d %s", n, one)
	}
	return fmt.Sprintf("%d %s", n, many)
}
