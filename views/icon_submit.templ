package views

// IconSubmit explains the community icon project for event tags: what's
// needed, at what size, and where to send finished work.
templ IconSubmit() {
	@Layout("Design an Event Icon · DECAY") {
		<section class="about">
			<p class="about-statement">Design an event icon</p>
			<p class="about-body">
				Events on the site get tagged with a type — Music, Film, Workshop, and so on —
				and we'd like each tag to have its own icon. We're starting with the eleven
				tags below. Pick one that's open, make an icon, and send it our way.
			</p>
			<p class="about-body">
				Size: 100x100px. Any style, any format (PNG, SVG, whatever you've got) — no
				other constraints. Have fun with it.
			</p>
		</section>

		<section class="events">
			<span class="section-label mono">Starter set</span>
			<ul class="volunteer-list">
				<li>Film & Documentary</li>
				<li>Music</li>
				<li>Art & Performance</li>
				<li>Drawing</li>
				<li>Games</li>
				<li>Dance Party</li>
				<li>Workshop</li>
				<li>Meeting</li>
				<li>Community & Mutual Aid</li>
				<li>Market / Swap</li>
				<li>Tech</li>
			</ul>
			<p class="about-body" style="margin-top:1rem">
				Send your icon (and which tag it's for) to us through the
				<a href="/contact">contact page</a>.
			</p>
		</section>
	}
}
