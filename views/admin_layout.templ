package views

import "decay-main/db"

// AdminLayout frames every admin page. The nav shows only the sections
// the signed-in account can reach, so it never offers a link that would
// come back as a 403.
templ AdminLayout(title string, me db.User) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
			<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/css/style.css"/>
		</head>
		<body>
			<div class="page page-admin">
				<header class="site-header admin-header">
					<a href="/admin">DECAY Admin</a>
					<nav class="site-nav admin-nav mono">
						if me.Can(db.PermEvents) {
							<a href="/admin/events">Events</a>
						}
						if me.Can(db.PermShop) {
							<a href="/admin/products">Shop</a>
						}
						if me.Can(db.PermPosts) {
							<a href="/admin/posts">Blog</a>
						}
						if me.Can(db.PermPhotos) {
							<a href="/admin/photos">Photos</a>
						}
						if me.Can(db.PermPeople) {
							<a href="/admin/people">People</a>
						}
						if me.Can(db.PermGroups) {
							<a href="/admin/groups">Groups</a>
						}
						if me.Can(db.PermMedia) {
							<a href="/admin/media">Media</a>
						}
						if me.Can(db.PermBookings) {
							<a href="/admin/bookings">Bookings</a>
						}
						if me.Can(db.PermReports) {
							<a href="/admin/reports">Reports</a>
						}
						if me.Can(db.PermStaff) {
							<a href="/admin/staff">Staff</a>
						}
						if me.Can(db.PermUsers) {
							<a href="/admin/users">Accounts</a>
						}
						<a href="/" target="_blank" rel="noopener">View site</a>
						<span class="admin-whoami">{ me.Name() }</span>
						<form method="post" action="/admin/logout" style="display:inline">
							<button type="submit" class="admin-btn admin-btn-small">Log out</button>
						</form>
					</nav>
				</header>
				<main class="admin-main">
					{ children... }
				</main>
			</div>
			<script src="/static/js/app.js"></script>
		</body>
	</html>
}
