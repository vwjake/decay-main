package views

import (
	"fmt"

	"decay-main/db"
)

templ AdminForms(forms []db.ExternalForm, me db.User, errorMsg string) {
	@AdminLayout("Forms · DECAY Admin", me) {
		<p class="admin-heading">Get Involved forms</p>
		<p class="admin-sub mono">
			Links shown on the public <a href="/get-involved" target="_blank" rel="noopener">Get Involved</a> page —
			Nextcloud Forms surveys and the like. The site only links out to these; it doesn't host them.
		</p>
		if errorMsg != "" {
			<div class="admin-flash admin-flash-error mono">{ errorMsg }</div>
		}

		<p class="admin-heading">Built into the site</p>
		<p class="admin-sub mono">
			Also linked from Get Involved, but part of the site's code rather than a
			form link — nothing to edit here, just where to find them.
		</p>
		<table class="admin-table">
			<tr>
				<th>Title</th>
				<th>Address</th>
				<th></th>
			</tr>
			<tr>
				<td>Community impact survey</td>
				<td class="mono">/community-survey</td>
				<td><a href="/community-survey" target="_blank" rel="noopener">Open</a></td>
			</tr>
			<tr>
				<td>Design an event icon</td>
				<td class="mono">/get-involved/icons</td>
				<td><a href="/get-involved/icons" target="_blank" rel="noopener">Open</a></td>
			</tr>
		</table>

		<p class="admin-heading">Form links</p>
		if len(forms) > 0 {
			for _, f := range forms {
				<form method="post" action={ templ.URL(fmt.Sprintf("/admin/forms/%d", f.ID)) } class="admin-form">
					<label>Title<input type="text" name="title" value={ f.Title } required/></label>
					<label>Description<input type="text" name="description" value={ f.Description } placeholder="Optional one-line blurb"/></label>
					<label>Form URL<input type="url" name="url" value={ f.URL } required/></label>
					<label>Order<input type="number" name="position" value={ fmt.Sprint(f.Position) }/></label>
					<label class="admin-check"><input type="checkbox" name="enabled" checked?={ f.Enabled }/> Shown on the Get Involved page</label>
					<div class="booking-actions">
						<button type="submit" class="admin-btn admin-btn-small">Save</button>
						<a href={ templ.URL(f.URL) } target="_blank" rel="noopener" class="admin-btn admin-btn-small">Open</a>
					</div>
				</form>
				<form method="post" action={ templ.URL(fmt.Sprintf("/admin/forms/%d/delete", f.ID)) } onsubmit="return confirm('Remove this form link?')" style="margin-bottom:24px">
					<button type="submit" class="admin-btn admin-btn-small admin-btn-danger">Delete</button>
				</form>
			}
		} else {
			<p class="admin-sub mono">No forms yet. Add one below.</p>
		}

		<p class="admin-heading">Add form</p>
		<form method="post" action="/admin/forms" class="admin-form">
			<label>Title<input type="text" name="title" placeholder="e.g. Community Impact Survey" required/></label>
			<label>Description<input type="text" name="description" placeholder="Optional one-line blurb"/></label>
			<label>Form URL<input type="url" name="url" placeholder="https://cloud.decay.events/apps/forms/s/…" required/></label>
			<label>Order<input type="number" name="position" value="0"/></label>
			<label class="admin-check"><input type="checkbox" name="enabled" checked/> Shown on the Get Involved page</label>
			<button type="submit" class="admin-btn">Add</button>
		</form>
	}
}
