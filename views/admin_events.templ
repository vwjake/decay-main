package views

import (
	"fmt"

	"decay-main/db"
)

templ AdminEvents(events []db.Event, page db.Page, me db.User, errorMsg string) {
	@AdminLayout("Events · DECAY Admin", me) {
		<p class="admin-heading">Events</p>
		if errorMsg != "" {
			<div class="admin-flash admin-flash-error mono">{ errorMsg }</div>
		}
		<p class="admin-sub mono">{ page.Range() }</p>
		<table class="admin-table">
			<tr>
				<th>Date</th>
				<th>Title</th>
				<th>Type</th>
				<th>Start</th>
				<th>End</th>
				<th></th>
				<th></th>
			</tr>
			for _, ev := range events {
				<tr>
					<td class="mono nowrap">{ ev.StartsAt.Format("Jan 2, 2006") }</td>
					<td>{ ev.Title }</td>
					<td>{ ev.EventType }</td>
					<td class="mono nowrap">{ ev.StartsAt.Format("3:04 PM") }</td>
					<td class="mono nowrap">
						if ev.EndsAt != nil {
							{ ev.EndsAt.Format("3:04 PM") }
						} else {
							&mdash;
						}
					</td>
					<td>
						<a href={ templ.URL(fmt.Sprintf("/admin/events/%d", ev.ID)) }>Edit</a>
					</td>
					<td>
						<a href={ templ.URL(ev.Path()) } target="_blank" rel="noopener">View</a>
					</td>
				</tr>
			}
		</table>
		@adminPager(page)

		<p class="admin-heading">Add event</p>
		<form method="post" action="/admin/events" class="admin-form">
			<label>Title<input type="text" name="title" required/></label>
			<label>Type<input type="text" name="event_type" placeholder="Workshop, Film, Meetup…" required/></label>
			<label>Starts at (Pacific time)<input type="datetime-local" name="starts_at" required/></label>
			<label>Ends at (optional, Pacific time)<input type="datetime-local" name="ends_at"/></label>
			<label>Location<input type="text" name="location" value="402 Washington St NE, Olympia WA"/></label>
			<label>Description<textarea name="description"></textarea></label>
			<label>Link<input type="text" name="link" placeholder="#"/></label>
			<fieldset class="admin-fieldset">
				<legend>Volunteers needed</legend>
				for _, role := range db.VolunteerRoles {
					<label class="admin-check">
						<input type="checkbox" name={ "volunteer_" + role } value="1"/>
						{ db.RoleLabel(role) }
					</label>
				}
			</fieldset>
			<p class="admin-sub mono">Add the flyer after creating the event.</p>
			<button type="submit" class="admin-btn">Create</button>
		</form>
	}
}

// adminPager is the pager for admin tables, which sit inside a narrower
// column than the public lists.
templ adminPager(page db.Page) {
	if page.Multiple() {
		<nav class="pager mono">
			if page.HasPrev() {
				<a href={ templ.URL(page.PrevURL()) } class="pager-link">&larr; Prev</a>
			} else {
				<span class="pager-link is-disabled">&larr; Prev</span>
			}
			<span class="pager-status">{ page.Label() }</span>
			if page.HasNext() {
				<a href={ templ.URL(page.NextURL()) } class="pager-link">Next &rarr;</a>
			} else {
				<span class="pager-link is-disabled">Next &rarr;</span>
			}
		</nav>
	}
}
