package views

import (
	"fmt"
	"time"

	"decay-main/bookingmail"
	"decay-main/db"
)

// EventDetailData bundles an event with its volunteer/signup context and
// its correspondence, the same way BookingDetailData does for a booking.
// Thread is the zero value when the mailbox isn't configured or the event
// has no contact email on file.
type EventDetailData struct {
	Event          db.Event
	Volunteers     []db.EventVolunteer
	Signups        []db.VolunteerSignup
	Users          []db.User
	Thread         bookingmail.Thread
	CanSend        bool
	MailboxAddress string
	Venue          *time.Location
	// ErrorMsg is a validation error from the details/flyer/repeat forms
	// on this page. FlashNotice/FlashError report the outcome of sending
	// a reply, same as the booking page.
	ErrorMsg    string
	FlashNotice string
	FlashError  string
}

func (d EventDetailData) emailThread() EmailThreadData {
	return EmailThreadData{
		Kind:           "events",
		ID:             d.Event.ID,
		Email:          d.Event.Email,
		Thread:         d.Thread,
		CanSend:        d.CanSend,
		MailboxAddress: d.MailboxAddress,
		Venue:          d.Venue,
	}
}

// AdminEventEdit manages the parts of an event that don't fit the create
// form: its flyer image, which volunteer roles it needs covered, and its
// correspondence with whoever organized it.
templ AdminEventEdit(d EventDetailData, me db.User) {
	{{ ev := d.Event }}
	@AdminLayout(ev.Title+" · DECAY Admin", me) {
		<a href="/admin/events" class="admin-back">&larr; All events</a>
		<p class="admin-heading">{ ev.Title }</p>
		<p class="admin-sub mono">
			{ ev.EventType } &middot; { ev.LongDate() } &middot; { ev.TimeRange() }
		</p>
		<p class="admin-sub mono">
			Public page: <a href={ templ.URL(ev.Path()) } target="_blank" rel="noopener">{ ev.Path() }</a>
		</p>
		if ev.InSeries() {
			<p class="admin-sub mono">
				Part of a <a href={ templ.URL(seriesPath(ev.SeriesID)) }>recurring series</a>.
				Title, type, description, location, link, and flyer can be pushed to
				every upcoming event in the series from there — editing them here
				only changes this date.
			</p>
		}
		if d.FlashNotice != "" {
			<div class="admin-flash mono">{ d.FlashNotice }</div>
		}
		if d.FlashError != "" {
			<div class="admin-flash admin-flash-error mono">{ d.FlashError }</div>
		}
		if d.ErrorMsg != "" {
			<div class="admin-flash admin-flash-error mono">{ d.ErrorMsg }</div>
		}

		<p class="admin-heading">Volunteer signups</p>
		if len(d.Signups) == 0 {
			<p class="admin-sub mono">No one has signed up through the site yet.</p>
		} else {
			<p class="admin-sub mono">People who offered to help through the public page. Reach out, then clear them once handled.</p>
			<table class="admin-table">
				<tr>
					<th>Name</th>
					<th>Contact</th>
					<th>Role</th>
					<th>Note</th>
					<th>When</th>
					<th></th>
				</tr>
				for _, s := range d.Signups {
					<tr>
						<td>{ s.Name }</td>
						<td class="mono">{ s.Contact }</td>
						<td>{ s.RoleLabel() }</td>
						<td>{ s.Note }</td>
						<td class="mono nowrap">{ s.When() }</td>
						<td>
							<form method="post" action={ templ.URL(fmt.Sprintf("/admin/events/%d/signups/%d/delete", ev.ID, s.ID)) } onsubmit="return confirm('Remove this signup?')">
								<button type="submit" class="admin-btn admin-btn-small admin-btn-danger">Clear</button>
							</form>
						</td>
					</tr>
				}
			</table>
		}

		<p class="admin-heading">Details</p>
		<form method="post" action={ templ.URL(fmt.Sprintf("/admin/events/%d", ev.ID)) } class="admin-form">
			<label>Title<input type="text" name="title" value={ ev.Title } required/></label>
			<label>Type<input type="text" name="event_type" value={ ev.EventType } required/></label>
			<label>
				Starts at (Pacific time)
				<input type="datetime-local" name="starts_at" value={ ev.StartsAt.Format("2006-01-02T15:04") } required/>
			</label>
			<label>
				Ends at (optional, Pacific time)
				<input type="datetime-local" name="ends_at" value={ endsAtValue(ev) }/>
			</label>
			<label>Location<input type="text" name="location" value={ ev.Location }/></label>
			<label>Description<textarea name="description">{ ev.Description }</textarea></label>
			<label>Link<input type="text" name="link" value={ ev.Link }/></label>
			<label>
				Web address
				<input type="text" name="slug" value={ ev.Slug }/>
			</label>
			<p class="admin-sub mono">
				Changing the address breaks links people have already shared.
				The event keeps its calendar identity either way, so edits
				reach subscribers as an update rather than a new event.
			</p>
			<label>
				Keyholder
				<input type="text" name="keyholder" value={ ev.Keyholder } list="keyholder-options" placeholder="Pick an account or type a name"/>
			</label>
			<datalist id="keyholder-options">
				for _, u := range d.Users {
					<option value={ u.Name() }/>
				}
			</datalist>
			<label>
				Organizer's name
				<input type="text" name="contact_name" value={ ev.ContactName }/>
			</label>
			<label>
				Organizer's email
				<input type="email" name="email" value={ ev.Email }/>
			</label>
			<p class="admin-sub mono">
				Carried over automatically when this event started as a
				booking request. Set here so the email history below can
				look up correspondence with anyone else.
			</p>
			<button type="submit" class="admin-btn">Save details</button>
		</form>

		<p class="admin-heading">Flyer</p>
		if ev.HasFlyer() {
			<img class="admin-flyer-preview" src={ ev.FlyerWebPath() } alt={ "Flyer for " + ev.Title }/>
		} else {
			<p class="admin-sub mono">No flyer yet.</p>
		}
		<form method="post" action={ templ.URL(fmt.Sprintf("/admin/events/%d/flyer", ev.ID)) } enctype="multipart/form-data" class="admin-form">
			<label>
				if ev.HasFlyer() {
					Replace flyer
				} else {
					Upload flyer
				}
				<input type="file" name="flyer" accept="image/*" required/>
			</label>
			<button type="submit" class="admin-btn">Save flyer</button>
		</form>

		<p class="admin-heading">Volunteers</p>
		<p class="admin-sub mono">
			Tick the jobs this event needs. The public page lists only the
			jobs still open — names stay here.
		</p>
		<form method="post" action={ templ.URL(fmt.Sprintf("/admin/events/%d/volunteers", ev.ID)) } class="admin-form">
			<table class="admin-table">
				<tr>
					<th>Needed</th>
					<th>Role</th>
					<th>Covered by</th>
				</tr>
				for _, role := range db.VolunteerRoles {
					<tr>
						<td>
							<input
								type="checkbox"
								name={ "needed_" + role }
								value="1"
								checked?={ hasRole(d.Volunteers, role) }
							/>
						</td>
						<td>{ db.RoleLabel(role) }</td>
						<td>
							<input
								type="text"
								name={ "name_" + role }
								value={ volunteerName(d.Volunteers, role) }
								placeholder="Still open"
							/>
						</td>
					</tr>
				}
			</table>
			<button type="submit" class="admin-btn">Save volunteers</button>
		</form>

		<p class="admin-heading">Repeat</p>
		<p class="admin-sub mono">
			Stamp out copies of this event on a schedule. Each copy is its own
			event — same details, flyer, and volunteer roles, on its own date and
			with its own calendar identity — that you can edit or delete
			separately afterward. Signups and reports aren't copied.
			if !ev.InSeries() {
				This turns the event into a series, with a page to keep the copies in sync.
			} else {
				The copies join this event's existing series.
			}
		</p>
		<form method="post" action={ templ.URL(fmt.Sprintf("/admin/events/%d/repeat", ev.ID)) } class="admin-form">
			<label>
				How often
				<select name="frequency">
					for _, f := range db.RepeatFrequencies {
						<option value={ f.Value }>{ f.Label }</option>
					}
				</select>
			</label>
			<label>How many copies<input type="number" name="count" value="4" min="1" max="52"/></label>
			<button type="submit" class="admin-btn">Create copies</button>
		</form>

		<p class="admin-heading">Delete</p>
		<p class="admin-sub mono">
			Deleting removes the event from the site and from the calendar
			feed. Anyone subscribed loses it at their next refresh.
		</p>
		<form method="post" action={ templ.URL(fmt.Sprintf("/admin/events/%d/delete", ev.ID)) } onsubmit="return confirm('Delete this event? This cannot be undone.')" class="admin-form">
			<button type="submit" class="admin-btn admin-btn-danger">Delete event</button>
		</form>

		@emailThreadPanel(d.emailThread())
	}
}

// endsAtValue formats an optional end time for a datetime-local input,
// which needs an empty string rather than a zero time when there isn't one.
func endsAtValue(ev db.Event) string {
	if ev.EndsAt == nil {
		return ""
	}
	return ev.EndsAt.Format("2006-01-02T15:04")
}

func hasRole(volunteers []db.EventVolunteer, role string) bool {
	for _, v := range volunteers {
		if v.Role == role {
			return true
		}
	}
	return false
}

func volunteerName(volunteers []db.EventVolunteer, role string) string {
	for _, v := range volunteers {
		if v.Role == role {
			return v.Name
		}
	}
	return ""
}
