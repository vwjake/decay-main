package views

import (
	"fmt"

	"decay-main/db"
)

// AdminEventEdit manages the parts of an event that don't fit the create
// form: its flyer image and which volunteer roles it needs covered.
templ AdminEventEdit(ev db.Event, volunteers []db.EventVolunteer, signups []db.VolunteerSignup, me db.User, errorMsg string) {
	@AdminLayout(ev.Title+" · DECAY Admin", me) {
		<a href="/admin/events" class="admin-back">&larr; All events</a>
		<p class="admin-heading">{ ev.Title }</p>
		<p class="admin-sub mono">
			{ ev.EventType } &middot; { ev.LongDate() } &middot; { ev.TimeRange() }
		</p>
		<p class="admin-sub mono">
			Public page: <a href={ templ.URL(ev.Path()) } target="_blank" rel="noopener">{ ev.Path() }</a>
		</p>
		if errorMsg != "" {
			<div class="admin-flash admin-flash-error mono">{ errorMsg }</div>
		}

		<p class="admin-heading">Details</p>
		<form method="post" action={ templ.URL(fmt.Sprintf("/admin/events/%d", ev.ID)) } class="admin-form">
			<label>Title<input type="text" name="title" value={ ev.Title } required/></label>
			<label>Type<input type="text" name="event_type" value={ ev.EventType } required/></label>
			<label>
				Starts at (Pacific time)
				<input type="datetime-local" name="starts_at" value={ ev.StartsAt.Format("2006-01-02T15:04") } required/>
			</label>
			<label>
				Ends at (optional, Pacific time)
				<input type="datetime-local" name="ends_at" value={ endsAtValue(ev) }/>
			</label>
			<label>Location<input type="text" name="location" value={ ev.Location }/></label>
			<label>Description<textarea name="description">{ ev.Description }</textarea></label>
			<label>Link<input type="text" name="link" value={ ev.Link }/></label>
			<label>
				Web address
				<input type="text" name="slug" value={ ev.Slug }/>
			</label>
			<p class="admin-sub mono">
				Changing the address breaks links people have already shared.
				The event keeps its calendar identity either way, so edits
				reach subscribers as an update rather than a new event.
			</p>
			<button type="submit" class="admin-btn">Save details</button>
		</form>

		<p class="admin-heading">Flyer</p>
		if ev.HasFlyer() {
			<img class="admin-flyer-preview" src={ ev.FlyerWebPath() } alt={ "Flyer for " + ev.Title }/>
		} else {
			<p class="admin-sub mono">No flyer yet.</p>
		}
		<form method="post" action={ templ.URL(fmt.Sprintf("/admin/events/%d/flyer", ev.ID)) } enctype="multipart/form-data" class="admin-form">
			<label>
				if ev.HasFlyer() {
					Replace flyer
				} else {
					Upload flyer
				}
				<input type="file" name="flyer" accept="image/*" required/>
			</label>
			<button type="submit" class="admin-btn">Save flyer</button>
		</form>

		<p class="admin-heading">Volunteers</p>
		<p class="admin-sub mono">
			Tick the jobs this event needs. The public page lists only the
			jobs still open — names stay here.
		</p>
		<form method="post" action={ templ.URL(fmt.Sprintf("/admin/events/%d/volunteers", ev.ID)) } class="admin-form">
			<table class="admin-table">
				<tr>
					<th>Needed</th>
					<th>Role</th>
					<th>Covered by</th>
				</tr>
				for _, role := range db.VolunteerRoles {
					<tr>
						<td>
							<input
								type="checkbox"
								name={ "needed_" + role }
								value="1"
								checked?={ hasRole(volunteers, role) }
							/>
						</td>
						<td>{ db.RoleLabel(role) }</td>
						<td>
							<input
								type="text"
								name={ "name_" + role }
								value={ volunteerName(volunteers, role) }
								placeholder="Still open"
							/>
						</td>
					</tr>
				}
			</table>
			<button type="submit" class="admin-btn">Save volunteers</button>
		</form>

		<p class="admin-heading">Volunteer signups</p>
		if len(signups) == 0 {
			<p class="admin-sub mono">No one has signed up through the site yet.</p>
		} else {
			<p class="admin-sub mono">People who offered to help through the public page. Reach out, then clear them once handled.</p>
			<table class="admin-table">
				<tr>
					<th>Name</th>
					<th>Contact</th>
					<th>Role</th>
					<th>Note</th>
					<th>When</th>
					<th></th>
				</tr>
				for _, s := range signups {
					<tr>
						<td>{ s.Name }</td>
						<td class="mono">{ s.Contact }</td>
						<td>{ s.RoleLabel() }</td>
						<td>{ s.Note }</td>
						<td class="mono nowrap">{ s.When() }</td>
						<td>
							<form method="post" action={ templ.URL(fmt.Sprintf("/admin/events/%d/signups/%d/delete", ev.ID, s.ID)) } onsubmit="return confirm('Remove this signup?')">
								<button type="submit" class="admin-btn admin-btn-small admin-btn-danger">Clear</button>
							</form>
						</td>
					</tr>
				}
			</table>
		}

		<p class="admin-heading">Delete</p>
		<p class="admin-sub mono">
			Deleting removes the event from the site and from the calendar
			feed. Anyone subscribed loses it at their next refresh.
		</p>
		<form method="post" action={ templ.URL(fmt.Sprintf("/admin/events/%d/delete", ev.ID)) } onsubmit="return confirm('Delete this event? This cannot be undone.')" class="admin-form">
			<button type="submit" class="admin-btn admin-btn-danger">Delete event</button>
		</form>
	}
}

// endsAtValue formats an optional end time for a datetime-local input,
// which needs an empty string rather than a zero time when there isn't one.
func endsAtValue(ev db.Event) string {
	if ev.EndsAt == nil {
		return ""
	}
	return ev.EndsAt.Format("2006-01-02T15:04")
}

func hasRole(volunteers []db.EventVolunteer, role string) bool {
	for _, v := range volunteers {
		if v.Role == role {
			return true
		}
	}
	return false
}

func volunteerName(volunteers []db.EventVolunteer, role string) string {
	for _, v := range volunteers {
		if v.Role == role {
			return v.Name
		}
	}
	return ""
}
