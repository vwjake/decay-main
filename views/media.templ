package views

import (
	"decay-main/db"
	"decay-main/youtube"
)

// MediaPage is the public /media page: what DECAY has recorded and
// photographed. Featured are the videos an admin picked at /admin/media —
// the same ones the home page carries — and Recent is whatever @no_tape
// has uploaded lately, read off YouTube's public feed. Either can be
// empty; the page just leaves that part out.
type MediaPage struct {
	Featured []db.Video
	Recent   []youtube.Video
	Photos   []db.Photo
	// ChannelURL is the channel the recent videos came from, empty when
	// the feed isn't configured.
	ChannelURL string
}

func (p MediaPage) HasVideos() bool { return len(p.Featured) > 0 || len(p.Recent) > 0 }

templ Media(p MediaPage) {
	@Layout("Media · DECAY") {
		<section class="about">
			<p class="about-statement">Media</p>
			<p class="about-body">Sets, sessions, and photographs from 402 Washington St NE.</p>
		</section>

		<section class="events">
			if p.HasVideos() {
				<span class="section-label mono">Photos</span>
			}
			if len(p.Photos) == 0 {
				<p class="about-body">No photos yet — check back soon.</p>
			} else {
				<div class="gallery">
					for i, photo := range p.Photos {
						<figure class="gallery-item" hidden?={ i > 0 }>
							<a href={ templ.URL(photo.Path()) } target="_blank" rel="noopener">
								<img src={ photo.WebPath() } alt={ photo.Alt() } loading="lazy"/>
							</a>
							if photo.Caption != "" {
								<figcaption class="gallery-caption mono">{ photo.Caption }</figcaption>
							}
						</figure>
					}
				</div>
				if len(p.Photos) > 1 {
					<button type="button" class="btn-outline mono" data-gallery-open>Check out the gallery</button>
				}
			}
		</section>

		if len(p.Featured) > 0 {
			<section class="events">
				<span class="section-label mono">Featured</span>
				<div class="media-list">
					for _, v := range p.Featured {
						<div class="media-video">
							<div class="media-video-frame">
								<iframe
									src={ templ.URL(v.EmbedURL()) }
									title={ videoTitle(v) }
									loading="lazy"
									referrerpolicy="strict-origin-when-cross-origin"
									allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
									allowfullscreen
								></iframe>
							</div>
							if v.Title != "" {
								<div class="media-video-caption mono">
									<span>{ v.Title }</span>
									<a href={ templ.URL(v.WatchURL()) } target="_blank" rel="noopener">YouTube &rarr;</a>
								</div>
							}
						</div>
					}
				</div>
			</section>
		}

		if len(p.Recent) > 0 {
			<section class="events">
				<span class="section-label mono">Recent video uploads</span>
				<div class="video-grid">
					for _, v := range p.Recent {
						<div class="video-item">
							<a href={ templ.URL(v.WatchURL()) } target="_blank" rel="noopener">
								<img src={ v.ThumbURL() } alt={ v.Title } loading="lazy"/>
								<span class="video-play">&#9654;</span>
							</a>
							<div class="video-caption mono">
								<span class="video-title">{ v.Title }</span>
								if v.PublishedLabel() != "" {
									<span class="video-date">{ v.PublishedLabel() }</span>
								}
							</div>
						</div>
					}
				</div>
				if p.ChannelURL != "" {
					<a href={ templ.URL(p.ChannelURL) } class="btn-outline mono" target="_blank" rel="noopener">
						No Tape on YouTube
					</a>
				}
			</section>
		}
	}
}
